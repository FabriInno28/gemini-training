    <style>
        :root {
            --bg-color: #0d0d0f;
            --card-bg: #18181c;
            --card-hover: #222228;
            --yellow: #ffd700;
            --yellow-hover: #e6c200;
            --text-light: #ffffff;
            --text-muted: #a0a0ab;
            --border: #2a2a30;
            --accent-green: #2ecc71;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; }
        body { background-color: var(--bg-color); color: var(--text-light); min-height: 100vh; padding: 20px; }

        .container { max-width: 960px; margin: 0 auto; }

        header { text-align: center; margin-bottom: 30px; padding: 20px 0; border-bottom: 2px solid var(--yellow); }
        header .club-tag { display: inline-block; background: rgba(255, 215, 0, 0.15); color: var(--yellow); font-weight: bold; font-size: 0.8rem; padding: 4px 12px; border-radius: 12px; letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 10px; }
        header h1 { font-size: 2.2rem; color: var(--yellow); text-transform: uppercase; letter-spacing: 2px; font-weight: 800; }
        header p { color: var(--text-muted); font-size: 1rem; margin-top: 6px; }

        /* Package Grid */
        .section-title { font-size: 1.1rem; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted); margin-bottom: 15px; display: flex; align-items: center; gap: 8px; }
        .section-title::before { content: ''; display: inline-block; width: 8px; height: 18px; background: var(--yellow); border-radius: 2px; }
        
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; margin-bottom: 40px; }
        .card { background: var(--card-bg); border: 1px solid var(--border); border-radius: 14px; padding: 22px; cursor: pointer; transition: all 0.25s ease; position: relative; overflow: hidden; }
        .card::before { content: ''; position: absolute; top: 0; left: 0; width: 4px; height: 100%; background: var(--yellow); opacity: 0.4; transition: opacity 0.25s; }
        .card:hover { border-color: var(--yellow); transform: translateY(-3px); background: var(--card-hover); }
        .card:hover::before { opacity: 1; }
        .card-num { font-size: 0.75rem; font-weight: 700; color: var(--yellow); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 6px; }
        .card h3 { font-size: 1.25rem; color: var(--text-light); margin-bottom: 6px; font-weight: 700; }
        .card p { color: var(--text-muted); font-size: 0.88rem; line-height: 1.4; margin-bottom: 14px; }
        .card-footer { display: flex; justify-content: space-between; align-items: center; font-size: 0.8rem; color: var(--yellow); font-weight: 600; border-top: 1px solid rgba(255,255,255,0.05); padding-top: 10px; }

        /* Workout Arena */
        .workout-area { background: var(--card-bg); border: 2px solid var(--yellow); border-radius: 20px; padding: 32px 24px; text-align: center; display: none; box-shadow: 0 10px 30px rgba(0,0,0,0.5); }
        .workout-area.active { display: block; animation: fadeIn 0.3s ease-in-out; }

        @keyframes fadeIn { from { opacity: 0; transform: scale(0.98); } to { opacity: 1; transform: scale(1); } }

        .progress-bar-dots { display: flex; justify-content: center; gap: 6px; margin-bottom: 20px; }
        .dot { width: 28px; height: 6px; background: var(--border); border-radius: 3px; transition: all 0.3s; }
        .dot.active { background: var(--yellow); }
        .dot.completed { background: var(--accent-green); }

        .phase-badge { display: inline-block; background: var(--yellow); color: #000; font-weight: 800; padding: 6px 18px; border-radius: 20px; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1px; margin-bottom: 16px; }
        .phase-badge.pause { background: #3a3a45; color: var(--yellow); border: 1px solid var(--yellow); }
        .phase-badge.atem { background: #1b3b2b; color: #2ecc71; border: 1px solid #2ecc71; }

        .exercise-title { font-size: 1.8rem; margin-bottom: 12px; font-weight: 700; line-height: 1.2; }
        .exercise-desc { color: var(--text-muted); font-size: 1.05rem; margin-bottom: 25px; min-height: 50px; max-width: 650px; margin-left: auto; margin-right: auto; line-height: 1.5; }

        .timer-display { font-size: 5rem; font-weight: 800; color: var(--yellow); font-family: 'Courier New', Courier, monospace; margin-bottom: 25px; text-shadow: 0 0 20px rgba(255, 215, 0, 0.2); }

        .btn-group { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; }
        .btn { background: var(--yellow); color: #000; border: none; padding: 14px 28px; font-weight: 800; font-size: 1rem; border-radius: 10px; cursor: pointer; transition: all 0.2s; text-transform: uppercase; letter-spacing: 0.5px; }
        .btn:hover { background: var(--yellow-hover); transform: translateY(-2px); }
        .btn-secondary { background: transparent; color: var(--text-light); border: 1px solid var(--border); }
        .btn-secondary:hover { background: #222; border-color: var(--text-muted); }

        footer { text-align: center; margin-top: 50px; color: var(--text-muted); font-size: 0.85rem; border-top: 1px solid var(--border); padding-top: 20px; }
    </style>
</head>
