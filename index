let timerInterval = null;
let isRunning = false;

// Web Audio API Beep Sound
function playSound(freq = 800, type = 'sine', duration = 0.15) {
    try {
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
        gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + duration);
    } catch (e) { console.log('Audio not supported or blocked'); }
}

function renderPackages() {
    const grid = document.getElementById('package-grid');
    grid.innerHTML = packages.map((pkg) => `
        <div class="card" onclick="selectPackage(${pkg.id})">
            <div class="card-num">10-MINUTEN PAKET</div>
            <h3>${pkg.name}</h3>
            <p>${pkg.desc}</p>
            <div class="card-footer">
                <span>4 ÜBUNGEN + ATEM</span>
                <span>STARTEN ➔</span>
            </div>
        </div>
    `).join('');
}

function selectPackage(id) {
    currentPkg = packages.find(p => p.id === id);
    currentStepIdx = 0;
    document.getElementById('overview-section').style.display = 'none';
    document.getElementById('workout-area').classList.add('active');
    renderDots();
    loadStep();
}

function renderDots() {
    const container = document.getElementById('dots-container');
    container.innerHTML = currentPkg.steps.map((_, i) => `<div class="dot ${i === 0 ? 'active' : ''}" id="dot-${i}"></div>`).join('');
}

function updateDots() {
    currentPkg.steps.forEach((_, i) => {
        const dot = document.getElementById(`dot-${i}`);
        if (!dot) return;
        dot.className = 'dot';
        if (i < currentStepIdx) dot.classList.add('completed');
        else if (i === currentStepIdx) dot.classList.add('active');
    });
}

function loadStep() {
    const step = currentPkg.steps[currentStepIdx];
    const badge = document.getElementById('phase-badge');
    badge.innerText = step.type;
    badge.className = 'phase-badge ' + (step.badgeClass || '');

    document.getElementById('ex-title').innerText = step.title;
    document.getElementById('ex-desc').innerText = step.desc;
    timeLeft = step.time;
    updateDisplay();
    updateDots();
}

function updateDisplay() {
    const mins = Math.floor(timeLeft / 60).toString().padStart(2, '0');
    const secs = (timeLeft % 60).toString().padStart(2, '0');
    document.getElementById('timer-display').innerText = `${mins}:${secs}`;
}

function toggleTimer() {
    if (isRunning) {
        clearInterval(timerInterval);
        document.getElementById('start-btn').innerText = "WEITER";
    } else {
        playSound(600, 'sine', 0.1);
        timerInterval = setInterval(() => {
            if (timeLeft > 0) {
                timeLeft--;
                if (timeLeft <= 3 && timeLeft > 0) playSound(700, 'sine', 0.1);
                updateDisplay();
            } else {
                clearInterval(timerInterval);
                playSound(1000, 'sine', 0.3);
                nextStep();
            }
        }, 1000);
        document.getElementById('start-btn').innerText = "PAUSE";
    }
    isRunning = !isRunning;
}

function nextStep() {
    clearInterval(timerInterval);
    isRunning = false;
    document.getElementById('start-btn').innerText = "START";
    if (currentStepIdx < currentPkg.steps.length - 1) {
        currentStepIdx++;
        loadStep();
        toggleTimer();
    } else {
        playSound(1200, 'sine', 0.5);
        alert("🎉 STARKE LEISTUNG! Training abgeschlossen.");
        resetWorkout();
    }
}

function resetWorkout() {
    clearInterval(timerInterval);
    isRunning = false;
    document.getElementById('workout-area').classList.remove('active');
    document.getElementById('overview-section').style.display = 'block';
    document.getElementById('start-btn').innerText = "START";
}

renderPackages();
</script>
</body>
</html>
